# Copied to dist/_headers by scripts/build-all.mjs (Cloudflare Workers Static Assets / Pages format).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite output is content-hashed: cache forever.
/:game/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sound clips change rarely (same names): a month.
/:game/audio/*
  Cache-Control: public, max-age=2592000

# …but the list of clips must always be fresh.
/:game/audio/available.json
  Cache-Control: no-cache

# Pages themselves: always revalidate, so a new deploy shows up at once.
/*.html
  Cache-Control: no-cache

# Landing-page clips: a day (re-recorded now and then under the same names).
/media/*
  Cache-Control: public, max-age=86400
