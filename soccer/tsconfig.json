{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "noEmit": true,
    "paths": {
      "@shared/*": ["../shared/src/*"],
      "@shared-tests/*": ["../shared/tests/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "../shared/src", "../shared/tests", "../deploy"]
}
